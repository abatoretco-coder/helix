# ── NAS deployment ────────────────────────────────────────────────────────────
# Set this to the IP of your NAS on the local network (e.g. 192.168.1.50)
NAS_IP=192.168.1.50
# Set a different port if 8080 is already used on your host
FRESHRSS_PORT=8080
# Override if host ports are already in use
POSTGRES_PORT=5432
REDIS_PORT=6379
DASHBOARD_PORT=3000
PROMETHEUS_PORT=19090

# Existing NAS Grafana endpoint (optional, used by import_grafana_dashboard.sh)
GRAFANA_URL=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=newsminio
MINIO_ROOT_PASSWORD=change_me_minio

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change_me_meili
# Read-only key for the dashboard (generate from master key after first boot)
MEILI_SEARCH_KEY=

# ── Helix API contract auth (Jarvis/service-to-service) ─────────────────────
# Set REQUIRE_API_TOKEN=true to enforce X-API-Token on /v1 endpoints.
REQUIRE_API_TOKEN=false
HELIX_API_TOKEN=change_me_internal_api_token

# ── AI models ────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=30

# ── Clustering ───────────────────────────────────────────────────────────────
CLUSTER_SIMILARITY_THRESHOLD=0.88
CLUSTER_WINDOW_HOURS=72

# ── Extraction behavior ──────────────────────────────────────────────────────
ENABLE_MORSS_FOR_ALL=false

# ── Daily briefing scheduling ────────────────────────────────────────────────
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIMEZONE=Europe/Paris
DAILY_BRIEFING_HOUR=7
DAILY_BRIEFING_MINUTE=30
DAILY_BRIEFING_CATEGORY=all
BRIEFING_TICK_SECONDS=30

# ── Retry and dead-letter behavior ───────────────────────────────────────────
EXTRACT_MAX_RETRIES=3
AI_MAX_RETRIES=3
CLUSTER_MAX_RETRIES=3
BRIEFING_MAX_RETRIES=3
EXTRACT_RETRY_BACKOFF_SECONDS=300
EXTRACT_RETRY_MAX_BACKOFF_SECONDS=3600
EXTRACT_RETRY_SCAN_LIMIT=25

# ── NAS low power mode / throttling ──────────────────────────────────────────
LOW_POWER_MODE=false
WORKER_RATE_LIMIT_MS=0
EXTRACT_WORKER_RATE_LIMIT_MS=0
AI_WORKER_RATE_LIMIT_MS=500
CLUSTER_WORKER_RATE_LIMIT_MS=0
BRIEFING_WORKER_RATE_LIMIT_MS=0

# ── Dashboard v1 token forwarding ────────────────────────────────────────────
NEXT_PUBLIC_HELIX_API_TOKEN=
DASHBOARD_BASIC_AUTH_ENABLED=false
DASHBOARD_BASIC_AUTH_USER=helix
DASHBOARD_BASIC_AUTH_PASSWORD=change_me_dashboard_password

# ── Obsidian export ───────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=
OBSIDIAN_BRIEFINGS_DIR=Helix/Briefings
OBSIDIAN_EXPORT_ENABLED=false
OBSIDIAN_EXPORT_PATH=exports/obsidian

# ── Home Assistant notifications ─────────────────────────────────────────────
HOME_ASSISTANT_WEBHOOK_URL=
HOME_ASSISTANT_WEBHOOK_TOKEN=

# ── Retention worker ────────────────────────────────────────────────────────
CLEANUP_INTERVAL_SECONDS=3600
PROCESSING_LOG_RETENTION_DAYS=30
RAW_ITEM_RETENTION_DAYS=14
MINIO_RETENTION_ENABLED=true
RAW_HTML_RETENTION_DAYS=90
RAW_JSON_RETENTION_DAYS=365

# ── Optional: OpenAI fallback (leave empty to use Ollama only) ────────────────
OPENAI_API_KEY=
